; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Skyholme"
config/version="0.9.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Skyholme"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.965, 0.94, 0.89, 1)
boot_splash/stretch_mode=0
boot_splash/image="res://brand/splash.png"
config/icon="res://icon.png"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
camera/depth_of_field/depth_of_field_bokeh_shape=2
camera/depth_of_field/depth_of_field_bokeh_quality=3
anti_aliasing/quality/msaa_3d=2
environment/volumetric_fog/volume_size=96

[shader_globals]

snow_cover={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.35
}
rain_amount={
"type": "float",
"value": 0.0
}

[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.sv.translation", "res://i18n/strings.en.translation")
locale/fallback="sv"
